{
  "openapi": "3.0.0",
  "paths": {
    "/posts/{id}": {
      "get": {
        "operationId": "PostsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get a single post by id",
        "tags": [
          "Posts"
        ]
      }
    },
    "/posts": {
      "get": {
        "operationId": "PostsController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "List all posts",
        "tags": [
          "Posts"
        ]
      },
      "post": {
        "description": "Stores the post and queues it for asynchronous embedding (Ollama) and indexing in Qdrant, so it becomes searchable via POST /ask.",
        "operationId": "PostsController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostCreateDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Add a text post",
        "tags": [
          "Posts"
        ]
      }
    },
    "/ask": {
      "post": {
        "description": "Queues the question for asynchronous processing by an AI agent (tool-use over the stored content) and returns immediately. Poll GET /questions/:id for the status and answer. The answer is also emailed to the given address once ready.",
        "operationId": "AskController_ask",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionCreateDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": ""
          }
        },
        "summary": "Ask a question about the stored content",
        "tags": [
          "Ask"
        ]
      }
    },
    "/questions/{id}": {
      "get": {
        "description": "answer stays null until status is READY. Does not return the email address on purpose.",
        "operationId": "QuestionsController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Get the status and answer for a question asked via POST /ask",
        "tags": [
          "Questions"
        ]
      }
    }
  },
  "info": {
    "title": "Content Hub API",
    "description": "API do dodawania treści (tekst, PDF, audio, obraz) i wyszukiwania po nich przez asystenta AI opartego o lokalny model (Ollama) i wektorową bazę Qdrant.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "PostCreateDto": {
        "type": "object",
        "properties": {}
      },
      "QuestionCreateDto": {
        "type": "object",
        "properties": {}
      }
    }
  }
}